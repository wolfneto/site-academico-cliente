m-0 p-0 mb-4\">\r\n        <button\r\n          id=\"botao-credito\"\r\n          v-if=\"pagamento_pedido.formas_pagamento.credito\"\r\n          type=\"button\"\r\n          class=\"btn btn-outline-info botão-metodo-pagamento m-1\"\r\n          @click=\"nextPage(1)\"\r\n        >\r\n          CARTÃO DE CRÉDITO <br />\r\n          <i class=\"far fa-credit-card fa-lg\"></i>\r\n        </button>\r\n        <button\r\n          v-if=\"pagamento_pedido.formas_pagamento.dois_cartoes\"\r\n          id=\"botao-boleto\"\r\n          type=\"button\"\r\n          @click=\"nextPage(3)\"\r\n          class=\"btn btn-outline-info botão-metodo-pagamento m-1\"\r\n        >\r\n          DOIS CARTÕES <br />\r\n          <i class=\"fas fa-credit-card\"></i> <i class=\"far fa-credit-card\"></i>\r\n        </button>\r\n        <button\r\n          v-if=\"pagamento_pedido.formas_pagamento.boleto\"\r\n          id=\"botao-boleto\"\r\n          type=\"button\"\r\n          class=\"btn botão-metodo-pagamento m-1\"\r\n          :class=\"\r\n            obj_disable.disabled ? 'btn-outline-danger' : 'btn-outline-info'\r\n          \"\r\n          :style=\"obj_disable.disabled ? 'opacity: 0.7' : ''\"\r\n          @click=\"\r\n            obj_disable.disabled\r\n              ? callSnackbar('error', 'ATENÇÃO', obj_disable.msg, 5000)\r\n              : nextPage(2)\r\n          \"\r\n        >\r\n          BOLETO À VISTA <br />\r\n          <i class=\"fas fa-barcode fa-lg\"></i>\r\n        </button>\r\n        <button\r\n          v-if=\"pagamento_pedido.formas_pagamento.pix\"\r\n          id=\"botao-pix\"\r\n          type=\"button\"\r\n          class=\"btn btn-outline-info botão-metodo-pagamento m-1\"\r\n          @click=\"nextPage(5)\"\r\n        >\r\n          PIX <br />\r\n          <i class=\"fas fa-qrcode\"></i>\r\n        </button>\r\n        <button\r\n          v-if=\"pagamento_pedido.formas_pagamento.outros\"\r\n          id=\"botao-boleto\"\r\n          type=\"button\"\r\n          c