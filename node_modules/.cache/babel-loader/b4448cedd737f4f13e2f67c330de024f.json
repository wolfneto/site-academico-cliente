AAAgC,CAAxC,EAAuB,eAAvB,EAAoC;AAAA;AAApC;;;AAICH,OAAK,EAAC;;;;;;;;sEAdbE,YAAA,CAAkCE,iBAAlC,EAAkC,IAAlC,EAAkC,IAAlC,EAAkC;AAAA;AAAlC,KAAkC,UAAlBC,IAAA,CAAAC,QAAkB,IAElCJ,YAAA,CAAwE,KAAxE,EAAwE;AAAnEF,SAAK,EAAC,UAA6D;AAAjDO,OAAG,EAAEC,QAAA,CAAAC,MAAA,CAAM,iBAAN,CAA4C;AAAjBC,OAAG,EAAC;AAAa,GAAxE;;AAAA,cAEWL,IAAA,CAAAM,UAAA,CAAWC,OAAX,CAAmBC,KAAnB,IAAwB,sBAAnCC,YAAA,CAeM,KAfN,EAAAC,UAAA,EAeM,CAdJb,YAAA,CAOM,KAPN,EAAAc,UAAA,EAOM,CANJd,YAAA,CAAkD,IAAlD,EAAkD,IAAlD,EAAI,SAAIe,gBAAA,CAAGZ,IAAA,CAAAM,UAAA,CAAWC,OAAX,CAAmBC,KAAnB,CAAyBK,IAA5B,CAAJ,GAAuC,IAA3C,EAA6C;AAAA;AAA7C,GAMI,EALJhB,YAAA,CAIO,MAJP,EAAAiB,UAAA,EAIO,aAHWjB,YAAA,CAAyB,GAAzB,EAAyB,IAAzB,EAAyBe,gBAAA,CAAnBG,MAAA,CAAAC,YAAmB,CAAzB,EAAkB;AAAA;AAAlB,GAGX,cAHkDC,UAGlD,cADLC,UACK,CAJP,CAKI,CAPN,CAcI,EALJrB,YAAA,CAIM,KAJN,EAAAsB,UAAA,EAIM,CAHJtB,YAAA,CAES,QAFT,EAES;AAFAuB,WAAK,EAAAC,MAAA,QAAAA,MAAA,MAAAC,MAAA,IAAEnB,QAAA,CAAAoB,kBAAA,EAAF,CAEL;AAF6BC,QAAI,EAAC,QAElC;AAF2C7B,SAAK,EAAC;AAEjD,GAFT,EAAyE,4BAAzE,CAGI,CAJN,CAKI,CAfN","names":["class","style","_createVNode","href","_component_Loader","_ctx","loading","src","$options","getURL","alt","objToStore","session","aluno","_createBlock","_hoisted_1","_hoisted_2","_toDisplayString","nome","_hoisted_3","$props","numeroPedido","_hoisted_6","_hoisted_8","_hoisted_9","onClick","_cache","$event","paginaInicialEvent","type"],"ignoreList":[],"sourceRoot":"","sources":["C:\\Users\\onedo\\OneDrive\\Área de Trabalho\\SOLIDENT NOVO\\site-academico-cliente\\src\\views\\pedidoPago.vue"],"sourcesContent":["<template>\r\n  <Loader v-show=\"loading\"></Loader>\r\n\r\n  <img class=\"dentinho\" :src=\"getURL('dentinho_4x.png')\" alt=\"dentinho\" />\r\n\r\n  <div v-if=\"objToStore.session.aluno != null\" class=\"container my-3\">\r\n    <div class=\"my-2\">\r\n      <h4>Olá {{ objToStore.session.aluno.nome }} !</h4>\r\n      <span style=\"font-size: 18px\">\r\n        O pedido numero <b>{{ numeroPedido }}</b> já foi pago! <br />\r\n        Você pode checar o status atual dele na página\r\n        <a href=\"/meusPedidos\">Meus pedidos.</a>\r\n      </span>\r\n    </div>\r\n\r\n    <div class=\"mt-4\">\r\n      <button @click=\"paginaInicialEvent()\" type=\"button\" class=\"btn btn-info\">\r\n        Voltar a pagina inicial!\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { mapState, mapActions } from \"vuex\";\r\nimport Loader from \"../components/Loader\";\r\nexport default {\r\n  data: () => ({\r\n    loading: false,\r\n    ObjToStore: null,\r\n  }),\r\n  components: {\r\n    Loader,\r\n  },\r\n  props: {\r\n    numeroPedido: [String],\r\n  },\r\n  async created() {\r\n    this.getSession();\r\n  },\r\n  computed: {\r\n    ...mapState({\r\n      pagamentoPedido: (state) => state.pagamentoPedido,\r\n    }),\r\n  },\r\n  methods: {\r\n    ...mapActions([\"get_pedido\"]),\r\n    async getSession() {\r\n      this.loading = true;\r\n      await this.get_pedido(this.numeroPedido);\r\n      this.objToStore = this.$LS.get();\r\n      if (\r\n        this.objToStore.session.aluno == null ||\r\n        this.pagamentoPedido.id_pedidos == undefined ||\r\n        this.pagamentoPedido.cpf_aluno != this.objToStore.session.aluno.cpf\r\n      ) {\r\n        this.$router.push({\r\n          name: \"inicio\",\r\n        });\r\n      } else if (\r\n        this.pagamentoPedido.status_aluno ==\r\n        (\"AGUARDANDO PAGAMENTO\" && \"EM ANÁLISE\")\r\n      ) {\r\n        this.$router.push({\r\n          name: \"SeusDados\",\r\n          params: { numeroPedido: this.numeroPedido },\r\n        });\r\n      }\r\n      this.loading = false;\r\n    },\r\n    paginaInicialEvent() {\r\n      this.$router.push({\r\n        name: \"inicio\",\r\n      });\r\n    },\r\n    getURL(img) {\r\n      return require(\"../assets/\" + img);\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.dentinho {\r\n  height: 200px;\r\n}\r\n</style>\r\n"]}]}