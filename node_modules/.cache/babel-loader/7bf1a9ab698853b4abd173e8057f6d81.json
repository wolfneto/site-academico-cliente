ion: row-reverse\">\r\n          <!-- <div\r\n            style=\"padding: 0px 5px\"\r\n            v-if=\"retorno_pagamento.boleto\"\r\n            class=\"col6 mb-3\"\r\n          >\r\n            <button\r\n              style=\"width: 100%\"\r\n              @click=\"imprimir_boleto()\"\r\n              type=\"button\"\r\n              class=\"btn btn-success\"\r\n            >\r\n              Imprimir Boleto!\r\n            </button>\r\n          </div> -->\r\n          <div\r\n            style=\"padding: 0px 5px\"\r\n            class=\"mb-1\"\r\n            :class=\"retorno_pagamento.boleto ? 'col6' : 'col-12'\"\r\n          >\r\n            <button\r\n              style=\"width: 100%\"\r\n              @click=\"pushInicio()\"\r\n              type=\"button\"\r\n              class=\"btn btn-info\"\r\n            >\r\n              Voltar ao inicio!\r\n            </button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport { mapState, mapMutations, mapActions } from \"vuex\";\r\nexport default {\r\n  data() {\r\n    return {\r\n      objToStore: { session: {}, shared: {} },\r\n    };\r\n  },\r\n  props: {\r\n    numeroPedido: [String],\r\n  },\r\n  async created() {\r\n    await this.get_pedido_sucesso_iugu(this.numeroPedido);\r\n    this.objToStore = this.$LS.get();\r\n\r\n    if (\r\n      this.iugu.pagamento.status_pagamento != \"PAGO\"\r\n    ) {\r\n      this.$router.push({\r\n        name: \"meusPedidos\",\r\n      });\r\n    } else {\r\n      //reservado/cobrado ou boleto\r\n      this.email_pagamento_sucesso({\r\n        aluno: this.objToStore.session.aluno,\r\n        pedido: {\r\n          outros: false,\r\n          valor: this.iugu.valor_total,\r\n          reservado: false,\r\n          boleto: false,\r\n          id_pedidos: this.iugu.id_pedidos,\r\n          link: \"\",\r\n        },\r\n      });\r\n      if (this.descontoUsado) {\r\n        this.update_desconto_representante(this.objToStore.session.aluno.cpf);\r\n        this.set_descontoUsado(false);\r\n      }\r\n      this.update_listas_vendidas(this.iugu.id_pedidos);\r\n      this.deleteLocalStorage();\r\n\r\n      this.iugu.valor_total = this.iugu.valor_total.replace(',', '.')\r\n    }\r\n  },\r\n  computed: {\r\n    ...mapState({\r\n      lastCheckoutid: (state) => state.lastCheckoutid,\r\n      retorno_pagamento: (state) => state.retorno_pagamento,\r\n      retorno_outros: (state) => state.retorno_outros,\r\n      descontoUsado: (state) => state.descontoUsado,\r\n      iugu: (state) => state.pedido_sucesso_iugu,\r\n    }),\r\n  },\r\n  methods: {\r\n    ...mapActions([\r\n      \"email_pagamento_sucesso\",\r\n      \"update_listas_vendidas\",\r\n      \"update_desconto_representante\",\r\n      \"get_pedido_sucesso_iugu\",\r\n    ]),\r\n    ...mapMutations([\r\n      \"set_refreshHeader\",\r\n      \"set_lastCheckoutid\",\r\n      \"set_descontoUsado\",\r\n    ]),\r\n    imprimir_boleto() {\r\n      window.open(this.retorno_pagamento.boleto.pdf);\r\n    },\r\n    pushInicio() {\r\n      this.$router.push({\r\n        name: \"inicio\",\r\n      });\r\n    },\r\n    getURL(img) {\r\n      return require(\"../assets/\" + img);\r\n    },\r\n    deleteLocalStorage() {\r\n      this.objToStore = this.$LS.get();\r\n      this.objToStore.session.carrinho = {\r\n        listas: [],\r\n        totalCarrinho: 0.0,\r\n        qtdItemsSelecionados: 0,\r\n        faculdade: {},\r\n        semestre: {},\r\n      };\r\n      delete this.objToStore.aluno;\r\n      delete this.objToStore.pedido;\r\n      delete this.objToStore.faculdade;\r\n      delete this.objToStore.semestre;\r\n      this.$LS.set(this.objToStore);\r\n      this.set_refreshHeader(true);\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.col6 {\r\n  flex: 0 0 auto;\r\n  width: 50%;\r\n}\r\n.dentinho {\r\n  height: 200px;\r\n}\r\n@media only screen and (max-width: 770px) {\r\n  .col6 {\r\n    flex: 0 0 auto;\r\n    width: 100%;\r\n  }\r\n  .content {\r\n    margin: 4px 15px !important;\r\n  }\r\n  .dentinho {\r\n    height: 140px;\r\n  }\r\n}\r\n.painel {\r\n  border-radius: 25px;\r\n  box-shadow: 0 0 1em 2px #7b7b7b;\r\n}\r\n.header {\r\n  padding: 10px 3px;\r\n  color: white;\r\n  border-top-left-radius: 25px;\r\n  border-top-right-radius: 25px;\r\n  background: var(--primary);\r\n  margin-bottom: 10px;\r\n}\r\n.content {\r\n  margin: 10px 50px;\r\n}\r\n</style>\r\n"],"mappings":";;;;EAEIA,KAAK,EAAC,4DAA4D;EAClEC,KAA2C,EAA3C;IAAA;IAAA;EAAA;;;EAEKD,KAAK,EAAC;AAAQ;gCACjBE,YAAA,CAEM;EAFDF,KAAK,EAAC;AAAQ,I,aACjBE,YAAA,CAAqC;EAAjCD,KAAmB,EAAnB;IAAA;EAAA;AAAmB,GAAC,UAAQ,E;;EAK7BD,KAAK,EAAC;AAAS;;EACbA,KAAK,EAAC,MAAM;EAACC,KAAwB,EAAxB;IAAA;EAAA;;iDAAyB,cAEvC;iDAKM,uBACc;iDAA4B,OAChD;gCAAAC,YAAA,CAAc,WAAX,SAAO;kDAAI,kBAEhB;;EAgBGF,KAAK,EAAC,KAAK;EAACC,KAAsD,EAAtD;IAAA;IAAA;EAAA;;;;uBAvCvBE,YAAA,CAuEM,OAvENC,UAuEM,GAnEJF,YAAA,CAkEM,OAlENG,UAkEM,GAjEJC,UAEM,EAENJ,YAAA,CAAgE;IAA1DK,GAAG,EAAEC,QAAA,CAAAC,MAAM;IAAqBC,GAAG,EAAC,EAAE;IAACV,KAAK,EAAC;wBAEnDE,YAAA,CA0DM,OA1DNS,UA0DM,GAzDJT,YAAA,CAyBM,OAzBNU,UAyBM,G,YAvBFV,YAAA,CAKM,WAAAW,gBAAA,KAJAC,IAAI,CAACC,YAAY;;;KAAoGC,MAAM,CAACC,IAAA,CAAAC,IAAI,CAACC,WAAW,Q,YAK9HjB,YAAA,CAA4B,WAAAW,gBAAA,CAAtBI,IAAA,CAAAC,IAAI,CAACE,UAAU,O,YACzCC,UAAc,E,eAkBlBnB,YAAA,CA6BM,OA7BNoB,WA6BM,GAdJpB,YAAA,CAaM;IAZJD,KAAwB,EAAxB;MAAA;IAAA,CAAwB;IACxBD,KAAK,GAAC,MAAM,EACJiB,IAAA,CAAAM,iBAAiB,CAACC,MAAM;MAEhCtB,YAAA,CAOS;IANPD,KAAmB,EAAnB;MAAA;IAAA,CAAmB;IAClBwB,OAAK,EAAAC,MAAA,QAAAA,MAAA,MAAAC,MAAA,IAAEnB,QAAA,CAAAoB,UAAU;IAClBC,IAAI,EAAC,QAAQ;IACb7B,KAAK,EAAC;KACP,qBAED,E","ignoreList":[]}]}