d_pedidos == undefined ||\r\n        this.pagamentoPedido.cpf_aluno != this.objToStore.session.aluno.cpf\r\n      ) {\r\n        this.$router.push({\r\n          name: \"inicio\",\r\n        });\r\n      } else if (\r\n        this.pagamentoPedido.status_aluno ==\r\n        (\"AGUARDANDO PAGAMENTO\" && \"EM ANÁLISE\")\r\n      ) {\r\n        this.$router.push({\r\n          name: \"SeusDados\",\r\n          params: { numeroPedido: this.numeroPedido },\r\n        });\r\n      }\r\n      this.loading = false;\r\n    },\r\n    paginaInicialEvent() {\r\n      this.$router.push({\r\n        name: \"inicio\",\r\n      });\r\n    },\r\n    getURL(img) {\r\n      return require(\"../assets/\" + img);\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.dentinho {\r\n  height: 200px;\r\n}\r\n</style>\r\n"],"mappings":";;;;;EAK+CA,KAAK,EAAC;;;EAC5CA,KAAK,EAAC;AAAM;;EAETC,KAAuB,EAAvB;IAAA;EAAA;AAAuB;iDAAC,mBACZ;iDAAyB,gBAAc;gCAAAC,YAAA,CAAM;iDAAA,kDAE7D;gCAAAA,YAAA,CAAwC;EAArCC,IAAI,EAAC;AAAc,GAAC,eAAa;;EAInCH,KAAK,EAAC;AAAM;;;;sEAdnBE,YAAA,CAAkCE,iBAAA,qB,SAAlBC,IAAA,CAAAC,OAAO,E,GAEvBJ,YAAA,CAAwE;IAAnEF,KAAK,EAAC,UAAU;IAAEO,GAAG,EAAEC,QAAA,CAAAC,MAAM;IAAqBC,GAAG,EAAC;wBAEhDL,IAAA,CAAAM,UAAU,CAACC,OAAO,CAACC,KAAK,Y,cAAnCC,YAAA,CAeM,OAfNC,UAeM,GAdJb,YAAA,CAOM,OAPNc,UAOM,GANJd,YAAA,CAAkD,YAA9C,MAAI,GAAAe,gBAAA,CAAGZ,IAAA,CAAAM,UAAU,CAACC,OAAO,CAACC,KAAK,CAACK,IAAI,IAAG,IAAE,MAC7ChB,YAAA,CAIO,QAJPiB,UAIO,G,YAHWjB,YAAA,CAAyB,WAAAe,gBAAA,CAAnBG,MAAA,CAAAC,YAAY,O,YAAqBC,UAAM,E,YAE7DC,UAAwC,C,KAI5CrB,YAAA,CAIM,OAJNsB,UAIM,GAHJtB,YAAA,CAES;IAFAuB,OAAK,EAAAC,MAAA,QAAAA,MAAA,MAAAC,MAAA,IAAEnB,QAAA,CAAAoB,kBAAkB;IAAIC,IAAI,EAAC,QAAQ;IAAC7B,KAAK,EAAC;KAAe,4BAEzE,E","ignoreList":[]}]}