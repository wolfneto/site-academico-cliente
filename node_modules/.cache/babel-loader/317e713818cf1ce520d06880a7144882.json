e-academico-cliente\\src\\views\\politica.vue"],"names":[],"mappings":";;;;;;;AACO,EAAA,KAAK,EAAC;;;8BACT,YAAA,CAEM,KAFN,EAEM;AAFD,EAAA,KAA+C,EAA/C;AAAA,wBAAA,SAAA;AAAA,aAAA;AAAA,GAEC;AAF+C,EAAA,KAAK,EAAC;AAErD,CAFN,E,cACE,YAAA,CAAuC,IAAvC,EAAuC;AAAnC,EAAA,KAAK,EAAC;AAA6B,CAAvC,EAAgB,oBAAhB,C,CADF,E;;AAAA,C;;;;;uBADF,YAAA,CA6EM,KA7EN,EAAA,UAAA,EA6EM,CA5EJ,UA4EI,EAzEJ,YAAA,CAAuG,KAAvG,EAAuG;AAAlG,IAAA,KAAK,EAAC,WAA4F;AAA/E,IAAA,GAAG,EAAE,OAAO,CAAA,2BAAA,CAAmE;AAApC,IAAA,GAAG,EAAC;AAAgC,GAAvG,E,IAAA,E;;AAAA,I,OAAA,CAyEI,EAxEJ,YAAA,CAA2F,KAA3F,EAA2F;AAAtF,IAAA,KAAK,EAAC,WAAgF;AAAnE,IAAA,GAAG,EAAE,OAAO,CAAA,qBAAA,CAAuD;AAA9B,IAAA,GAAG,EAAC;AAA0B,GAA3F,E,IAAA,E;;AAAA,I,OAAA,CAwEI,EAvEJ,mBAAA,CAAA,wtFAAA,CAuEI,CA7EN,C","sourcesContent":["<template>\r\n  <div class=\"container my-4 py-2 ; painel\">\r\n    <div style=\"background-color: #2bbacb; color: white\" class=\"painel\">\r\n      <h2 class=\"p-2\">POLÍTICA COMERCIAL</h2>\r\n    </div>\r\n    <img class=\"img-fluid\" :src=\"require('../assets/CONFERENCIA.jpg')\" alt=\"politica conferencia solident\">\r\n    <img class=\"img-fluid\" :src=\"require('../assets/TROCA.jpg')\" alt=\"politica troca solident\">\r\n    <!-- <div class=\"text-margin\">\r\n      <p style=\"font-size: 21px; color: black\" class=\"text-center ; mx-1\">\r\n        <Tag><h2>Conferência de Materiais</h2></Tag>\r\n      </p>\r\n      <div class=\"container d-flex align-items-center justify-content-center\">\r\n        <div style=\"max-width: 400px;\">\r\n          <p\r\n            style=\"margin: 0;\r\n        text-indent: 2rem;\r\n        text-align: justify;\"\r\n          >\r\n            Todos os pedidos solicitados à Dental Solident passam por cuidadoso\r\n            processo de separação e conferência via código de barras, usando um\r\n            rigoroso processo informatizado que permite ter a garantia do item\r\n            enviado.\r\n          </p>\r\n          <p\r\n            style=\"margin: 0;\r\n        text-indent: 2rem;\r\n        text-align: justify;\"\r\n          >\r\n            Caso o cliente, após receber seus materiais, note a falta de algum\r\n            item, ele tem o prazo de <u style=\"color:red\">7 (sete) dias corridos</u> para entrar\r\n            em contato com o Setor Pós-Vendas, por meio da opção Pós-Venda do\r\n            menu principal.\r\n          </p>\r\n          <p\r\n            style=\"margin: 0;\r\n        text-indent: 2rem;\r\n        text-align: justify;\r\n        color:red\"\r\n          >\r\n            Após esse prazo não são aceitas reclmações.\r\n          </p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <div class=\"text-margin\">\r\n      <p style=\"font-size: 21px; color: black\" class=\"text-center ; mx-1\">\r\n        <Tag><h2>Trocas e Devoluções</h2></Tag>\r\n      </p>\r\n      <div class=\"container d-flex align-items-center justify-content-center\">\r\n        <div style=\"max-width: 400px;\">\r\n          <p\r\n            style=\"margin: 0;\r\n        text-indent: 2rem;\r\n        text-align: justify;\"\r\n          >\r\n            Após a entrega do pedido, os clientes da Dental Solident tem até <u style=\"color:red\">10 (dez) dias corridos</u>\r\n            para solicitar alguma Troca ou Devolução de mercadoria. Troca e devoluções só são\r\n            aceitas com os produtos na embalagem original lacrada.\r\n          </p>\r\n          <p\r\n            style=\"margin: 0;\r\n        text-indent: 2rem;\r\n        text-align: justify;\"\r\n          >\r\n            Para comunicar troca ou devolução acessar o link do setor de Pós-Vendas, clicando\r\n            na opção Pós-Venda do menu principal.\r\n          </p>\r\n          <p\r\n            style=\"margin: 0;\r\n        text-indent: 2rem;\r\n        text-align: justify;\r\n        color:red\"\r\n          >\r\n            Após esse prazo não são aceitas reclmações.\r\n          </p>\r\n        </div>\r\n      </div>\r\n    </div> -->\r\n  </div>\r\n</template>\r\n\r\n<script>\r\n// import Tag from \"primevue/tag\";\r\nexport default {\r\n  // components: {\r\n  //   Tag,\r\n  // },\r\n  data: () => ({}),\r\n  created() {},\r\n  mounted() {},\r\n  computed: {},\r\n  methods: {},\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.painel {\r\n  transition: box-shadow 0.2s;\r\n  box-shadow: 0px 0px 15px #00000062;\r\n  border-radius: 10px;\r\n}\r\n.painel:hover {\r\n  box-shadow: 0px 0px 30px #00000062;\r\n}\r\n.painel-header {\r\n  padding: 4px 8px;\r\n  background-color: #2bbacb;\r\n  color: white;\r\n  border-top-left-radius: 10px;\r\n  border-top-right-radius: 10px;\r\n}\r\n\r\n.text-margin {\r\n  margin-left: 40px;\r\n  margin-right: 40px;\r\n}\r\n.pergunta {\r\n  margin-left: 10px;\r\n  margin-top: 20px;\r\n  display: inline-block;\r\n  color: black;\r\n}\r\n.resposta {\r\n  margin: 10px;\r\n  display: inline-block;\r\n  color: #696969;\r\n}\r\n@media only screen and (max-device-width: 600px) {\r\n  .text-margin {\r\n    margin-left: 20px;\r\n    margin-right: 20px;\r\n  }\r\n  .pergunta {\r\n    font-size: 18px;\r\n  }\r\n  .resposta {\r\n    font-size: 18px;\r\n  }\r\n}\r\n</style>\r\n"],"sourceRoot":""}]}