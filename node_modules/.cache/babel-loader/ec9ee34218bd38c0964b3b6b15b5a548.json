\\Área de Trabalho\\SOLIDENT NOVO\\site-academico-cliente\\src\\views\\pedidoPago.vue"],"sourcesContent":["<template>\r\n  <Loader v-show=\"loading\"></Loader>\r\n\r\n  <img class=\"dentinho\" :src=\"getURL('dentinho_4x.png')\" alt=\"dentinho\" />\r\n\r\n  <div v-if=\"objToStore.session.aluno != null\" class=\"container my-3\">\r\n    <div class=\"my-2\">\r\n      <h4>Olá {{ objToStore.session.aluno.nome }} !</h4>\r\n      <span style=\"font-size: 18px\">\r\n        O pedido numero <b>{{ numeroPedido }}</b> já foi pago! <br />\r\n        Você pode checar o status atual dele na página\r\n        <a href=\"/meusPedidos\">Meus pedidos.</a>\r\n      </span>\r\n    </div>\r\n\r\n    <div class=\"mt-4\">\r\n      <button @click=\"paginaInicialEvent()\" type=\"button\" class=\"btn btn-info\">\r\n        Voltar a pagina inicial!\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { mapState, mapActions } from \"vuex\";\r\nimport Loader from \"../components/Loader\";\r\nexport default {\r\n  data: () => ({\r\n    loading: false,\r\n    ObjToStore: null,\r\n  }),\r\n  components: {\r\n    Loader,\r\n  },\r\n  props: {\r\n    numeroPedido: [String],\r\n  },\r\n  async created() {\r\n    this.getSession();\r\n  },\r\n  computed: {\r\n    ...mapState({\r\n      pagamentoPedido: (state) => state.pagamentoPedido,\r\n    }),\r\n  },\r\n  methods: {\r\n    ...mapActions([\"get_pedido\"]),\r\n    async getSession() {\r\n      this.loading = true;\r\n      await this.get_pedido(this.numeroPedido);\r\n      this.objToStore = this.$LS.get();\r\n      if (\r\n        this.objToStore.session.aluno == null ||\r\n        this.pagamentoPedido.id_pedidos == undefined ||\r\n        this.pagamentoPedido.cpf_aluno != this.objToStore.session.aluno.cpf\r\n      ) {\r\n        this.$router.push({\r\n          name: \"inicio\",\r\n        });\r\n      } else if (\r\n        this.pagamentoPedido.status_aluno ==\r\n        (\"AGUARDANDO PAGAMENTO\" && \"EM ANÁLISE\")\r\n      ) {\r\n        this.$router.push({\r\n          name: \"SeusDados\",\r\n          params: { numeroPedido: this.numeroPedido },\r\n        });\r\n      }\r\n      this.loading = false;\r\n    },\r\n    paginaInicialEvent() {\r\n      this.$router.push({\r\n        name: \"inicio\",\r\n      });\r\n    },\r\n    getURL(img) {\r\n      return require(\"../assets/\" + img);\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.dentinho {\r\n  height: 200px;\r\n}\r\n</style>\r\n"],"mappings":"AAwBA,SAASA,QAAQ,EAAEC,UAAS,QAAS,MAAM;AAC3C,OAAOC,MAAK,MAAO,sBAAsB;AACzC,eAAe;EACbC,IAAI,EAAEA,CAAA,MAAO;IACXC,OAAO,EAAE,KAAK;IACdC,UAAU,EAAE;EACd,CAAC,CAAC;EACFC,UAAU,EAAE;IACVJ;EACF,CAAC;EACDK,KAAK,EAAE;IACLC,YAAY,EAAE,CAACC,MAAM;EACvB,CAAC;EACD,MAAMC,OAAOA,CAAA,EAAG;IACd,IAAI,CAACC,UAAU,CAAC,CAAC;EACnB,CAAC;EACDC,QAAQ,EAAE;IACR,GAAGZ,QAAQ,CAAC;MACVa,eAAe,EAAGC,KAAK,IAAKA,KAAK,CAACD;IACpC,CAAC;EACH,CAAC;EACDE,OAAO,EAAE;IACP,GAAGd,UAAU,CAAC,CAAC,YAAY,CAAC,CAAC;IAC7B,MAAMU,UAAUA,CAAA,EAAG;MACjB,IAAI,CAACP,OAAM,GAAI,IAAI;MACnB,MAAM,IAAI,CAACY,UAAU,CAAC,IAAI,CAACR,YAAY,CAAC;MACxC,IAAI,CAACS,UAAS,GAAI,IAAI,CAACC,GAAG,CAACC,GAAG,CAAC,CAAC;MAChC,IACE,IAAI,CAACF,UAAU,CAACG,OAAO,CAACC,KAAI,IAAK,IAAG,IACpC,IAAI,CAACR,eAAe,CAACS,UAAS,IAAKC,SAAQ,IAC3C,IAAI,CAACV,eAAe,CAACW,SAAQ,IAAK,IAAI,CAACP,UAAU,CAACG,OAAO,CAACC,KAAK,CAACI,GAAE,EAClE;QACA,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC;UAChBC,IAAI,EAAE;QACR,CAAC,CAAC;MACJ,OAAO,IACL,IAAI,CAACf,eAAe,CAACgB,YAAW,KAC/B,sBAAqB,IAAK,YAAY,GACvC;QACA,IAAI,CAACH,OAAO,CAACC,IAAI,CAAC;UAChBC,IAAI,EAAE,WAAW;UACjBE,MAAM,EAAE;YAAEtB,YAAY,EAAE,IAAI,CAACA;UAAa;QAC5C,CAAC,CAAC;MACJ;MACA,IAAI,CAACJ,OAAM,GAAI,KAAK;IACtB,CAAC;IACD2B,kBAAkBA,CAAA,EAAG;MACnB,IAAI,CAACL,OAAO,CAACC,IAAI,CAAC;QAChBC,IAAI,EAAE;MACR,CAAC,CAAC;IACJ,CAAC;IACDI,MAAMA,CAACC,GAAG,EAAE;MACV,OAAOC,OAAO,CAAC,YAAW,GAAID,GAAG,CAAC;IACpC;EACF;AACF,CAAC","ignoreList":[]}]}