{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://site-academico-servidor-production.up.railway.app/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://site-academico-servidor-production.up.railway.app/socket.io/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
